 :-  row(R1), queen(R1,C), queen(R2,C), column(C),R1!=R2, row(R2).
 :-  row(R1),R1-R2=C1-C2, queen(R2,C2),R1!=R2, row(R2), column(C2), column(C1), queen(R1,C1).
 :-  row(R1), queen(R2,C2),R1!=R2, row(R2), column(C2), column(C1), queen(R1,C1),R1-R2=C2-C1.
occupied(R) :-  queen(R,C), row(R), column(C).
 :-  queen(R,C2), column(C2), column(C1), queen(R,C1),C1!=C2, row(R).
 :-  row(R),not occupied(R).

